APP_NAME=LarastoryVPN
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://larastory.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

#--------------------------------------------------------------------------
# 3x-ui Panel Configuration (legacy fallback — see SERVERS_JSON below)
#--------------------------------------------------------------------------
XUI_HOST=3x-ui
XUI_PORT=2053
XUI_PATH=
XUI_USERNAME=admin
XUI_PASSWORD=your_secure_password
XUI_INBOUND_ID=1

#--------------------------------------------------------------------------
# Telegram Bot Configuration
#--------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

#--------------------------------------------------------------------------
# Mini App Configuration
#--------------------------------------------------------------------------
# URL the Mini App is served from. Must be HTTPS (Telegram requires this).
# Defaults to APP_URL/app.
MINIAPP_APP_URL=
# Optional support link shown in the Profile screen.
MINIAPP_SUPPORT_URL=
# Seconds after which an initData HMAC is rejected (default 86400 = 24h).
MINIAPP_INIT_DATA_TTL=86400

#--------------------------------------------------------------------------
# Multi-Server Registry
#--------------------------------------------------------------------------
# JSON array of server definitions. See config/servers.php for schema.
# When empty, a single "primary" server is seeded from XUI_* vars above.
# Example:
# SERVERS_JSON=[{"slug":"us-hetzner-1","name":"Helsinki","country":"Finland","country_code":"FI","flag_emoji":"🇫🇮","host":"vpn.example.com","port":8443,"inbound_id":1,"xui_host":"xui.example.com","xui_port":2053,"xui_username":"admin","xui_password":"xxx","is_active":true,"is_coming_soon":false,"tags":["recommended"],"sort_order":0}]
SERVERS_JSON=

#--------------------------------------------------------------------------
# VPN Domain Configuration
#--------------------------------------------------------------------------
VPN_PRIMARY_DOMAIN=larastory.com
VPN_PANEL_DOMAIN=dashboard.larastory.com
VPN_SUBSCRIPTION_PORT=2096

#--------------------------------------------------------------------------
# VPN Client Defaults
#--------------------------------------------------------------------------
VPN_DEFAULT_DEVICE_LIMIT=2
VPN_DEFAULT_TRAFFIC_LIMIT=0
